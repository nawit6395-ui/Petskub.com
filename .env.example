
# Environment (Client)
VITE_SUPABASE_URL=https://your-project.supabase.co
# Supabase anon key (publishable)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Some parts of the app also accept this alias
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# App
VITE_SITE_URL=http://localhost:5173
VITE_MAPTILER_API_KEY=your-maptile-key

# Environment (Serverless /api share endpoints on Vercel)
# Recommended to use service role here so the OG endpoints can always read data.
# Never expose this in the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# reCAPTCHA removed from this project. If you need it later, set `VITE_RECAPTCHA_SITE_KEY` and `RECAPTCHA_SECRET_KEY`.
